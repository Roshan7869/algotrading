{
    "_comment": "CANONICAL CONFIG 3/3 - DRY-RUN (paper). Purpose: the Phase 2.3 paper-trading session on the 20-pair futures universe; writes tradesv3.dryrun.sqlite. Owner: Phase 1.2 of EXECUTION_PLAN.md; launched by scripts/supervise.py (Phase 0.3). dry_run=true is mandatory here - never arm this file (plan anti-goal 5). LEVERAGE: strategy leverage() callbacks decide; the 'leverage' key is advisory only (read by repo scripts, not by freqtrade) - docs/leverage-matrix.md. STOPLOSS: config-level value OVERRIDES the strategy attribute (strategy_resolver.py:106-114).",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "1h",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "DOGE/USDT:USDT",
            "XRP/USDT:USDT"
        ],
        "pair_blacklist": [
            "BNB/.*"
        ],
        "retries": 5,
        "timeout": 60
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "edge": {
        "enabled": false
    },
    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "username": "freqtrader",
        "password": "${FREQTRADE_API_PASSWORD}",
        "jwt_secret": "${FREQTRADE_JWT_SECRET}"
    },
    "bot_name": "freqtrade_dryrun",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    },
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 60,
    "leverage": 3,
    "stoploss": -0.05,
    "db_url": "sqlite:///tradesv3.dryrun.sqlite"
}

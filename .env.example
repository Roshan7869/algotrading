# Freqtrade Trading Bot Configuration
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git!

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
# Get your bot token from @BotFather on Telegram
# Get your chat ID from @userinfobot on Telegram
TELEGRAM_TOKEN=7553420615:AAGXB2ORviX1AA1gXpSfwZC0l8tZKWjHW7M
TELEGRAM_CHAT_ID=1990546056

# =============================================================================
# EXCHANGE API CREDENTIALS
# =============================================================================
# Binance API credentials (get from https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
# Dry run mode (true = paper trading, false = live trading)
DRY_RUN=true

# Initial wallet balance for dry run (USDT)
DRY_RUN_WALLET=1000

# Maximum number of open trades
MAX_OPEN_TRADES=5

# Leverage (use with caution!)
LEVERAGE=6

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================
# Database URL (optional, defaults to SQLite)
# DB_URL=sqlite:///user_data/tradesv3.sqlite

# Freqtrade API settings (for remote control)
# API_SERVER_ENABLED=true
# API_SERVER_LISTEN_ADDR=127.0.0.1
# API_SERVER_PORT=8080
# API_SERVER_USERNAME=freqtrade
# API_SERVER_PASSWORD=your_secure_password_here
